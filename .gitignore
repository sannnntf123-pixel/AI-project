# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Virtual environment (never commit: 400MB+ of compiled binaries) ----
.venv/
venv/
env/

# ---- Data: ignore the contents, keep the folders visible on GitHub ----
# git cannot re-include a file inside a fully-excluded directory, so we
# exclude the *contents* (data/*) rather than the directory itself.
data/*
!data/raw/
!data/processed/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ---- Model checkpoints (same pattern) ----
models/*
!models/.gitkeep

# ---- Loose data files anywhere ----
*.csv
*.tsv
*.jsonl
*.parquet
*.bin
*.pt
*.pth
*.safetensors
*.ckpt

# ---- Training / experiment output ----
outputs/
runs/
logs/
wandb/
*.log

# ---- Human-feedback votes (written by the Gradio app at runtime) ----
app/votes/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Editors / OS ----
.DS_Store
.idea/
.vscode/
*.swp

# ---- Secrets ----
.env
*.key
kaggle.json
