# Copy to .env and edit, or just export these in your shell.
# Nothing here is secret; .env is gitignored anyway.

# --- Which model to use -------------------------------------------------
# local = sshleifer/tiny-gpt2 (fast, gibberish output, for testing code)
# colab = gpt2                (the real model, for actual training)
# Auto-detected if unset: "colab" inside Google Colab, else "local".
# JOKE_RL_PROFILE=local

# Override the model for one run, regardless of profile. Useful for testing
# the real GPT-2 locally once it is downloaded.
# JOKE_RL_BASE_MODEL=gpt2

# --- Where things live --------------------------------------------------
# Point the project at Google Drive so Colab training survives a disconnect,
# and so the local Gradio app can serve a Colab-trained model.
# JOKE_RL_MODELS_DIR=/content/drive/MyDrive/joke-rl/models
# JOKE_RL_DATA_DIR=/content/drive/MyDrive/joke-rl/data

# Serve one exact checkpoint in the app instead of the best available.
# JOKE_RL_APP_MODEL=/content/drive/MyDrive/joke-rl/models/rl
